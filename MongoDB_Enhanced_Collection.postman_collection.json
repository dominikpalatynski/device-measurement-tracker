        {
            "name": "Get Measurements Custom Time Range",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/api/mongodb/measurements?startTime={{$timestamp}}&endTime={{$timestamp}}",
                    "host": ["{{base_url}}"],
                    "path": ["api", "mongodb", "measurements"],
                    "query": [
                        {
                            "key": "startTime",
                            "value": "{{$timestamp}}",
                            "description": "Unix timestamp - 1 hour ago"
                        },
                        {
                            "key": "endTime",
                            "value": "{{$timestamp}}",
                            "description": "Unix timestamp - now"
                        }
                    ]
                }
            },
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "// Set timestamps for 1 hour range",
                            "const now = Math.floor(Date.now() / 1000);",
                            "const oneHourAgo = now - 3600;",
                            "pm.variables.set('startTime', oneHourAgo);",
                            "pm.variables.set('endTime', now);"
                        ],
                        "type": "text/javascript"
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Get Custom Time Range Success', function () {",
                            "    pm.response.to.have.status(200);",
                            "    const response = pm.response.json();",
                            "    pm.expect(response.success).to.be.true;",
                            "    pm.expect(response.data).to.be.an('array');",
                            "    console.log('Custom time range measurements:', response.data.length);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
