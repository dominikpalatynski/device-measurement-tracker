    "item": [
        {
            "name": "MongoDB Connection Test",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/api/mongodb/ping",
                    "host": ["{{base_url}}"],
                    "path": ["api", "mongodb", "ping"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('MongoDB Connection Successful', function () {",
                            "    pm.response.to.have.status(200);",
                            "    const response = pm.response.json();",
                            "    pm.expect(response.success).to.be.true;",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "Get All Measurements (No Filters)",
