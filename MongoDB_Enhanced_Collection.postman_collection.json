                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Get Device Measurements Success', function () {",
                            "    pm.response.to.have.status(200);",
                            "    const response = pm.response.json();",
                            "    pm.expect(response.success).to.be.true;",
                            "    pm.expect(response.data).to.be.an('array');",
                            "    if (response.data.length > 0) {",
                            "        pm.expect(response.data[0].deviceId).to.equal(pm.variables.get('deviceId'));",
                            "    }",
                            "    console.log('Device measurements:', response.data.length);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
